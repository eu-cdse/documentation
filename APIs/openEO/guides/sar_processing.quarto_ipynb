"method\": \"near\", \"projection\": 3857, \"resolution\": 10}, \"process_id\": \"resample_spatial\"}, \"sarbackscatter1\": {\"arguments\": {\"coefficient\": \"sigma0-ellipsoid\", \"contributing_area\": false, \"data\": {\"from_node\": \"loadcollection1\"}, \"elevation_model\": null, \"ellipsoid_incidence_angle\": false, \"local_incidence_angle\": false, \"mask\": false, \"noise_removal\": true}, \"process_id\": \"sar_backscatter\"}, \"saveresult1\": {\"arguments\": {\"data\": {\"from_node\": \"resamplespatial1\"}, \"format\": \"GTiff\", \"options\": {\"filename_prefix\": \"median_composite\", \"separate_asset_per_band\": true}}, \"process_id\": \"save_result\"}}}, \"progress\": 100, \"stac-version\": \"1.1\", \"status\": \"finished\", \"title\": \"SAR sigma0 monthly composites (docs)\", \"updated\": \"2026-11-26T09:38:13Z\", \"usage\": {\"cpu\": {\"unit\": \"cpu-seconds\", \"value\": 7410}, \"cpu_utilization_ratio\": {\"unit\": \"fraction\", \"value\": 0.8420465554669332}, \"duration\": {\"unit\": \"seconds\", \"value\": 804}, \"input_pixel\": {\"unit\": \"mega-pixel\", \"value\": 2340.375}, \"max_executor_memory\": {\"unit\": \"gb\", \"value\": 2.856037139892578}, \"memory\": {\"unit\": \"mb-seconds\", \"value\": 63223200}, \"memory_requested\": {\"unit\": \"mb-seconds\", \"value\": 66777600}, \"network_received\": {\"unit\": \"b\", \"value\": 77449014641}, \"orfeo_backscatter_input_pixels\": {\"unit\": \"count\", \"value\": 2454061056}, \"peak_execution_memory\": {\"unit\": \"bytes\", \"value\": 505604649}, \"sar_backscatter_soft_errors\": {\"unit\": \"fraction\", \"value\": 0}, \"total_stage_failures\": {\"unit\": \"count\", \"value\": 0}, \"total_task_failures\": {\"unit\": \"count\", \"value\": 0}}}}</script>\n",
