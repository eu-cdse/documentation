"method\": \"near\", \"projection\": 3857, \"resolution\": 10}, \"process_id\": \"resample_spatial\"}, \"sarbackscatter1\": {\"arguments\": {\"coefficient\": \"gamma0-terrain\", \"contributing_area\": false, \"data\": {\"from_node\": \"loadcollection1\"}, \"elevation_model\": null, \"ellipsoid_incidence_angle\": false, \"local_incidence_angle\": false, \"mask\": false, \"noise_removal\": true}, \"process_id\": \"sar_backscatter\"}, \"saveresult1\": {\"arguments\": {\"data\": {\"from_node\": \"resamplespatial1\"}, \"format\": \"GTiff\", \"options\": {\"filename_prefix\": \"median_composite\", \"separate_asset_per_band\": true}}, \"process_id\": \"save_result\"}}}, \"progress\": 100, \"stac-version\": \"1.1\", \"status\": \"finished\", \"title\": \"SAR gamma0 monthly composites (docs)\", \"updated\": \"2026-11-26T09:24:37Z\", \"usage\": {\"cpu\": {\"unit\": \"cpu-seconds\", \"value\": 7644}, \"cpu_utilization_ratio\": {\"unit\": \"fraction\", \"value\": 0.8456048585101305}, \"duration\": {\"unit\": \"seconds\", \"value\": 806}, \"input_pixel\": {\"unit\": \"mega-pixel\", \"value\": 2046.0378875732422}, \"max_executor_memory\": {\"unit\": \"gb\", \"value\": 2.6190185546875}, \"memory\": {\"unit\": \"mb-seconds\", \"value\": 65208000}, \"memory_requested\": {\"unit\": \"mb-seconds\", \"value\": 69962400}, \"network_received\": {\"unit\": \"b\", \"value\": 32342135535}, \"peak_execution_memory\": {\"unit\": \"bytes\", \"value\": 190547284}, \"total_stage_failures\": {\"unit\": \"count\", \"value\": 0}, \"total_task_failures\": {\"unit\": \"count\", \"value\": 0}}}}</script>\n",
